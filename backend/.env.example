# Copy to backend/.env and fill in real values (backend/.env is gitignored).
# asynch speaks the native ClickHouse protocol (port 9000).
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=voice
CLICKHOUSE_TABLE=voice.turns

# Presigned S3 audio URLs. Leave AUDIO_S3_BUCKET empty to disable the
# /audio endpoints (they return 503).
AUDIO_S3_BUCKET=pigugu-clickhouse-audio
AUDIO_S3_REGION=us-west-1
